# --- OpenAI (script expansion + scene image generation) ---
OPENAI_API_KEY=
# Budget defaults: one medium-quality full-model cast sheet, then lower-cost
# mini scene edits. Use high only for selected hero frames, not every scene.
OPENAI_REFERENCE_MODEL=gpt-image-1
OPENAI_REFERENCE_QUALITY=medium
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium

# --- ElevenLabs (narration voice + word-level timestamps) ---
# https://elevenlabs.io -> Profile -> API key. Voice ids from Voice Library.
# ELEVENLABS_VOICE_ID is used when the story's narrator_gender is "male"
# (also the default/fallback); ELEVENLABS_VOICE_ID_FEMALE when "female".
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_FEMALE=
# More expressive dramatic defaults; tune per selected voice if required.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.32
ELEVENLABS_SIMILARITY=0.82
ELEVENLABS_STYLE=0.50

# --- ffmpeg ---
# Only needed if plain `ffmpeg` on your machine lacks the subtitles filter
# (true for Homebrew's default formula). Point this at ffmpeg-full instead.
# e.g. FFMPEG_BIN=/usr/local/opt/ffmpeg-full/bin/ffmpeg
FFMPEG_BIN=
# Free ffmpeg overlay shown during the final seconds of every preview.
SUBSCRIBE_CTA_ENABLED=true
SUBSCRIBE_CTA_TEXT=SUBSCRIBE
SUBSCRIBE_CTA_SECONDS=3.5

# --- YouTube (Google Cloud OAuth client, YouTube Data API v3 enabled) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Filled in automatically by `npm run auth:youtube`
YOUTUBE_REFRESH_TOKEN=
# Applied only after a render is manually approved. public is the normal
# final setting; use unlisted during initial channel tests.
YOUTUBE_PRIVACY_STATUS=public

# --- Supabase (temp public hosting for Instagram's video_url requirement,
# and the storyline queue the web form writes to) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=faceless-shorts-renders

# --- Instagram Graph API ---
IG_USER_ID=
IG_ACCESS_TOKEN=
