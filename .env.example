# --- OpenAI (script generation + TTS + Whisper timestamps) ---
OPENAI_API_KEY=

# --- Pexels (free stock b-roll video) ---
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- YouTube (Google Cloud OAuth client, YouTube Data API v3 enabled) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Filled in automatically by `npm run auth:youtube`
YOUTUBE_REFRESH_TOKEN=

# --- Supabase (temp public hosting for Instagram's video_url requirement) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=faceless-shorts-renders

# --- Instagram Graph API ---
IG_USER_ID=
IG_ACCESS_TOKEN=
